float fAuto
float fYield
float fAir
float fVaultTime
float fVaultHeight
float fStartZ
float fStartX
float fStartY
float fPlayerHeight
float fDuration
float fT
float fEase
float fNewZ
float fCooldown
float fMaxHeight
float fMinHeight
float fCastTopZ
float fHeadBotZ
float fLimit
float fCastOK
float fHitX
float fYaw
float fSample
float fBestX
float fBestY
float fBestZ
float fOverX
float fOverY
float fHitY
float fHitZ
float fBestRun
float fClear
float fDelta
float fDepth
float fDirX
float fDirY
float fDist
float fHits
float fRayYaw
float fSweep
float fProbe
float fBestDist
float fGoDist
float fGoX
float fGoY
float fNewX
float fNewY
float fCamYaw
float fCamNudge
float fLastOff
float fOff
float fEnv
float fPitch
float fPitchWant
float fRise
float fPrevSample
float fCamTime
float fCamDur
float fPushForce
float fPushHead
float fPickH
float fLowMax
float fSprint
float fSounds
float fLow
float fKey
float fRetry
float fCfg
float fRead
ref rIdle
int iSnd
string_var sSnd

begin function {}

	; MCM writes to Data\config\Mantle.ini and this reads it back, once a second.
	;
	; There is no plugin here to notice the file changed, so the loop has to look
	; -- but not every frame, and not at the moment of a climb either, where the
	; file access would land inside the one thing that has to feel immediate.
	; A second is far below anyone's patience for a menu they just closed.
	set fCfg to player.AuxVarGetFlt "*_Mantle_Cfg" 0
	set fCfg to fCfg - GetSecondsPassed
	if fCfg <= 0
		set fCfg to 1

		; A sentinel first, because a missing file reads as zeroes rather than as
		; an error, and one of those zeroes is the retry delay -- which would put
		; the sweep back to thirty ray casts every frame against any wall. So
		; nothing is taken from the file unless the file is demonstrably there,
		; and the load script's defaults stand until it is.
		set fRead to GetINIFloat "Mantle:iVersion" "Mantle.ini"
		if fRead > 0
			set fRead to GetINIFloat "Mantle:bAuto" "Mantle.ini"
			player.AuxVarSetFlt "*_Mantle_Auto" fRead 0

			set fRead to GetINIFloat "Mantle:fRetry" "Mantle.ini"
			player.AuxVarSetFlt "*_Mantle_Retry" fRead 0

			set fRead to GetINIFloat "Mantle:fCamNudge" "Mantle.ini"
			player.AuxVarSetFlt "*_Mantle_CamNudge" fRead 0

			set fRead to GetINIFloat "Mantle:fPush" "Mantle.ini"
			player.AuxVarSetFlt "*_Mantle_Push" fRead 0
		endif
	endif
	player.AuxVarSetFlt "*_Mantle_Cfg" fCfg 0

	; The view dips and comes back, and turning is left entirely alone.
	;
	; X is pitch here, Z is yaw. Both have been tried and only one of them is
	; wanted: the dip on X is the effect that was asked for and it survives;
	; lagging Z was tried in v41 and is gone, because being able to turn while
	; climbing is worth more than any weight added to it.
	;
	; The dip is additive, not a lock. It swells and fades on a half sine --
	; zero at both ends, most in the middle -- so it returns on its own with no
	; restore step. Last frame's contribution is subtracted before this frame's
	; is worked out, so what sits underneath is always the player's own aim and
	; nothing accumulates. The mouse answers throughout.
	set fCamTime to player.AuxVarGetFlt "*_Mantle_CamTime" 0
	if fCamTime > 0
		set fCamDur to player.AuxVarGetFlt "*_Mantle_CamTotal" 0
		set fCamTime to fCamTime - GetSecondsPassed
		player.AuxVarSetFlt "*_Mantle_CamTime" fCamTime 0

		set fLastOff to player.AuxVarGetFlt "*_Mantle_CamOff" 0
		set fPitch to player.GetAngle X
		set fPitch to fPitch - fLastOff

		set fOff to 0
		if fCamTime > 0
			set fT to fCamDur - fCamTime
			set fT to fT / fCamDur
			set fEnv to fT * 180
			set fEnv to fSin fEnv
			set fOff to player.AuxVarGetFlt "*_Mantle_CamNudgeNow" 0
			set fOff to fOff * fEnv
		endif

		set fPitchWant to fPitch + fOff
		player.SetAngle X fPitchWant
		player.AuxVarSetFlt "*_Mantle_CamOff" fOff 0
	endif

	set fVaultTime to player.AuxVarGetFlt "*_Mantle_Time" 0

	if fVaultTime > 0
		set fVaultHeight to player.AuxVarGetFlt "*_Mantle_Height" 0
		set fStartZ to player.AuxVarGetFlt "*_Mantle_StartZ" 0
		set fDuration to player.AuxVarGetFlt "*_Mantle_Duration" 0

		set fVaultTime to fVaultTime - GetSecondsPassed
		player.AuxVarSetFlt "*_Mantle_Time" fVaultTime 0

		if fVaultTime <= 0
			; Hand back a body that is not already falling fast.
			;
			; The controller spends the whole climb believing it is in free fall,
			; because it is: something is moving the player upward every frame and
			; nothing is telling the physics about it, so gravity keeps
			; integrating underneath. By the time control is handed back there is
			; a fair amount of downward speed built up out of nothing, and the
			; player drops off the top of what they just climbed.
			;
			; Zero is written rather than anything measured, because the two
			; velocity functions do not appear to share a scale -- the setter is
			; documented in units of 7 units per second while the getter reads
			; like raw units per second, and guessing wrong there launches the
			; player rather than failing quietly. Zero needs no conversion.
			;
			; This does not stop the fall, it only forgets the part of it that the
			; climb invented. Gravity resumes from rest on the next frame.
			player.SetActorVelocity Z 0
			PPEndInteraction

			; And a shove in the direction of travel, once, on the way out.
			;
			; The climb ends with the body over the ledge and no reason to keep
			; going, because the trigger required a standstill and the position
			; drive supplied no velocity, only positions. Everything so far has
			; been about arriving on top; this is about not stopping dead there.
			;
			; PushActorNoRagdoll rather than SetActorVelocity: the heading
			; convention is known from a working script and the velocity pair's
			; scale is not, and a single shove is exactly the case Player
			; Physics' own knockback path is written for -- its comment says as
			; much, that the one-shot impulse holds for a one-off and not for
			; something pushing every frame.
			set fPushForce to player.AuxVarGetFlt "*_Mantle_Push" 0
			if fPushForce > 0
				set fPushHead to player.AuxVarGetFlt "*_Mantle_PushHead" 0
				player.PushActorNoRagdoll fPushForce fPushHead player 0
			endif
			return
		endif

		set fT to fDuration - fVaultTime
		set fT to fT / fDuration

		; Up on an ease-out, forward on an ease-in. Two curves rather than one,
		; because a mantle is not a diagonal: the body goes up first and comes
		; over second. Sharing a curve reads as being dragged through the corner
		; of the obstacle.
		set fEase to 1 - fT
		set fEase to fEase * fEase
		set fEase to 1 - fEase
		set fNewZ to fVaultHeight * fEase
		set fNewZ to fStartZ + fNewZ
		player.SetPos Z fNewZ


		; Forward is driven only for a climb that started from the ground.
		;
		; The drive exists because the ground trigger insists the player is nearly
		; stopped, so there is no momentum to finish the climb with and something
		; has to supply it. In the air the opposite is true -- the player is
		; already travelling, that is what being in the air means -- and driving
		; the position then does not add movement, it *replaces* it. A jump aimed
		; at the next ledge gets rewritten into a short slow hop to twenty units
		; past the near edge, which lands short and falls.
		;
		; So up here the climb only lifts, and the jump the player already made
		; carries them the rest of the way. Their own arc is better than anything
		; measured from the moment the key went down.
		set fAir to player.AuxVarGetFlt "*_Mantle_Air" 0
		if fAir
			return
		endif

		set fEase to fT * fT
		set fStartX to player.AuxVarGetFlt "*_Mantle_Start" 0
		set fStartY to player.AuxVarGetFlt "*_Mantle_Start" 1
		set fGoX to player.AuxVarGetFlt "*_Mantle_Go" 0
		set fGoY to player.AuxVarGetFlt "*_Mantle_Go" 1

		set fNewX to fGoX - fStartX
		set fNewX to fNewX * fEase
		set fNewX to fStartX + fNewX
		set fNewY to fGoY - fStartY
		set fNewY to fNewY * fEase
		set fNewY to fStartY + fNewY

		player.SetPos X fNewX
		player.SetPos Y fNewY
		return
	endif

	set fCooldown to player.AuxVarGetFlt "*_Mantle_Cooldown" 0
	if fCooldown > 0
		set fCooldown to fCooldown - GetSecondsPassed
		player.AuxVarSetFlt "*_Mantle_Cooldown" fCooldown 0
		return
	endif

	if IsControlPressed 0 == 0
		return
	endif

	set fAuto to player.AuxVarGetFlt "*_Mantle_Auto" 0

	; Jump is no longer accepted as an activate key. It has a job of its own now:
	; getting high enough that the measurement below can reach the top of
	; something a standing player could never take.
	set fKey to 0
	if IsControlPressed 5
		set fKey to 1
	elseif fAuto == 0
		return
	endif

	; Not "has the player been stuck for a while" but "is the player getting
	; anywhere right now". The blocked timer needs history before it can answer,
	; and the three frames it needed were three frames of the climb feeling dead.
	; The ratio is true on the frame it happens.
	;
	; SkyParkour reaches the same place from the other side, refusing to climb
	; while the player is still moving at more than a fifth of their commanded
	; speed. Same test, no accumulation.
	;
	; In the air the question does not apply at all: nothing stops a jump against
	; a wall, so the ratio stays at 1 and a stall never arrives. Airborne is its
	; own permission -- but not immediately. The first fraction of a second off
	; the ground is spent at ankle height with nothing yet in reach, so a climb
	; asked for there is a climb asked for too early.
	; And the same reasoning excuses the key from it.
	;
	; Waiting to be stopped can only ever find obstacles that stop you, and the
	; low ones do not: the character controller steps over them and the ratio
	; never falls. That is why the low animation never played once -- not because
	; the test that picks it is wrong, but because nothing low ever reached it.
	;
	; A press says what the stall was being used to infer, so on the ground it
	; stands in for it. Left on for the keyless mode, where there is nothing else
	; to separate climbing a kerb from walking over one.
	set fAir to PPInAir
	if fAir
		if PPAirTime < 0.17
			return
		endif
	elseif fKey == 0
		if PPSpeedRatio > 0.25
			return
		endif
	endif

	if player.GetDead
		return
	endif
	if player.IsSneaking
		return
	endif
	if player.GetAnimAction == 2
		return
	endif

	; Charge for the attempt, not for the success. Without it there is nothing to
	; stop a player leaning on a wall from paying thirty ray casts and a line of
	; log every single frame, forever. A success overwrites this with its own
	; longer wait, so nothing legitimate is slowed down.
	;
	; This is the whole of the delay before a climb, and it is worth being clear
	; about why: none of the *tests* wait any more. On the ground with the key
	; there is no speed test at all, and the keyless one answers on the frame it
	; is asked. What was left was this -- a failed read costing a fixed pause
	; before the next one, and a read fails whenever the player arrives at an
	; angle or a shade too early, which is most of the time a press feels late.
	set fRetry to player.AuxVarGetFlt "*_Mantle_Retry" 0
	player.AuxVarSetFlt "*_Mantle_Cooldown" fRetry 0

	set fPlayerHeight to player.GetObjectDimensions Z
	if fPlayerHeight < 1
		set fPlayerHeight to 128
	endif

	player.GetPosEx (fStartX) (fStartY) (fStartZ)

	; Every height below is measured from where the player is standing *now*, and
	; that is the whole of the jump support -- there is no separate limit for it
	; and no second code path.
	;
	; The cap was never "how tall an object may be", it is "how far above himself
	; a person can haul themselves", which is the same number whether the feet
	; are on the ground or sixty units above it at the top of a jump. Jumping at
	; a wall simply moves the window up by the height of the jump, so a wall out
	; of reach from a stand comes into reach from the air, and the arithmetic
	; that rejects a cliff face is untouched.
	set fMaxHeight to fPlayerHeight * 0.70
	set fMinHeight to fPlayerHeight * 0.14

	; How far down each stop looks: past the bottom of the climbable range, far
	; enough to find the ground underneath it.
	;
	; The rays once ran 200 units and always found something, so a miss and a
	; floor reading were the same answer and neither meant anything. Bounding
	; them to the climbable range fixed that and introduced the opposite problem:
	; the cast could no longer see ordinary ground, so it could not tell how far
	; up a surface actually was from what lay beneath it.
	;
	; Reaching below the range and testing the range separately gives both. Three
	; distinct answers instead of two: a surface worth climbing, a surface too
	; low to bother with but real and measurable, and a genuine drop.
	set fCastTopZ to fStartZ + fMaxHeight
	set fProbe to fMaxHeight + 60

	; Sweeping outward and probing down, rather than finding the face and stepping
	; past it.
	;
	; Finding the face first was always the fragile half. It needed a scan up
	; several heights because one ray slips between fence boards, and then an
	; offset past whatever it found, and no single offset is right -- too little
	; reads the near side, too much clears a thin rail entirely.
	;
	; None of that is needed. The rays going down do not care what is in front of
	; the player; they only care where the ground is at a series of distances. So
	; walk out along the facing at a fixed spacing, drop a ray at each stop, and
	; let the highest surface win. The face never has to be located at all.
	;
	; A single forward ray at the top of the window says how far out is worth
	; walking. If it hits, everything past that point is inside something and the
	; obstacle is taller than a person can climb anyway. SkyParkour grows this ray
	; one step at a time; one cast returns the same distance for a fraction of the
	; cost.
	set fYaw to player.GetAngle Z
	set fDirX to fSin fYaw
	set fDirY to fCos fYaw
	set fRayYaw to 0 - fYaw

	set fSweep to fPlayerHeight * 0.55
	set fCastOK to GetPointRayCastPos (fStartX) (fStartY) (fCastTopZ) (0) (fRayYaw) (fHitX) (fHitY) (fHitZ) 19 fSweep
	if fCastOK
		set fClear to GetVector3DDistance fHitX fHitY fCastTopZ fStartX fStartY fCastTopZ
	else
		set fClear to fSweep
	endif

	set fVaultHeight to 0
	set fBestX to 0
	set fBestY to 0
	set fBestZ to 0
	set fBestDist to 0
	set fBestRun to 0
	set fRise to 0
	set fPrevSample to 0
	set fHits to 0
	set fDist to 6

	Label 1
	set fOverX to fDirX * fDist
	set fOverX to fStartX + fOverX
	set fOverY to fDirY * fDist
	set fOverY to fStartY + fOverY

	; The ray reaches well below the window on purpose.
	;
	; Bounding it to the climbable range answered "is there a ledge here" in one
	; step, and that is why the step test could not work: a stop that found
	; ordinary ground a unit under the window came back as a miss, a miss was
	; read as ground level, and so the first stop to enter the window always
	; showed a step of the window's own depth -- about eighteen units, out of
	; nothing. Which is exactly why raising the threshold did not help, and why
	; it would have had to go past eighteen to do anything at all, taking every
	; genuine low ledge with it.
	;
	; So the ray is long enough to find the ground whatever the ground is doing,
	; and the window is applied afterwards as a test rather than as the shape of
	; the cast. A miss now means a real drop, not a surface just out of range.
	set fCastOK to GetPointRayCastPos (fOverX) (fOverY) (fCastTopZ) (-90) (0) (fHitX) (fHitY) (fHitZ) 19 fProbe
	if fCastOK
		set fSample to fHitZ - fStartZ

		if fSample >= fMinHeight
			set fHits to fHits + 1

			; Depth: how many stops came back at the height that won, times the
			; spacing. One stop is a rail or a fence board, several is a surface
			; with a top a person could stand on.
			;
			; Counted against the winner rather than as a running streak. The
			; streak was wrong and reported a depth of one for everything: on a
			; flat top the winner is the *first* stop to reach that height, so the
			; streak at the moment of winning is always one, and every stop after
			; it matched without beating it and went uncounted.
			if fSample > fVaultHeight
				set fVaultHeight to fSample
				set fBestX to fOverX
				set fBestY to fOverY
				set fBestZ to fHitZ
				set fBestDist to fDist
				set fBestRun to 1

				; The size of the jump onto this surface, measured against the
				; real height of the ground one stop back. Ground and gentle
				; slopes gain a unit or two per stop; a ledge arrives at once.
				set fRise to fSample - fPrevSample
			else
				set fDelta to fVaultHeight - fSample
				if fDelta <= 6
					set fBestRun to fBestRun + 1
				endif
			endif
		endif

		set fPrevSample to fSample
	else
		; Nothing even below the feet: a drop, and a drop before a ledge is as
		; much of a step as anything.
		set fPrevSample to 0
	endif

	set fDist to fDist + 4
	if fDist <= fClear
		Goto 1
	endif

	set fDepth to fBestRun * 4

	; clear says how far ahead the head-height ray got: a small number means the
	; obstacle is taller than the window, which is a different failure from
	; finding nothing, and used to be indistinguishable. dir is printed because
	; the facing vector is the one piece of this built on an assumed convention;
	; if it were backwards, every sweep would walk behind the player and hits
	; would be zero everywhere.
	PrintC "Mantle: air %.0f clear %.0f hits %.0f | h %.1f rise %.0f depth %.0f" fAir fClear fHits fVaultHeight fRise fDepth

	if fVaultHeight <= 0
		return
	endif

	set fOverX to fBestX
	set fOverY to fBestY
	set fHitZ to fBestZ

	set fHeadBotZ to fHitZ + 4
	set fLimit to fHitZ + fPlayerHeight
	set fCastOK to GetPointRayCastPos (fOverX) (fOverY) (fHeadBotZ) (90) (0) (fHitX) (fHitY) (fHitZ) 19 200
	if fCastOK != 0
		if fHitZ < fLimit
			PrintC "Mantle: no headroom"
			return
		endif
	endif

	set fLowMax to player.AuxVarGetFlt "*_Mantle_LowMax" 0
	set fLowMax to fPlayerHeight * fLowMax

	; A low thing has to be a step, not a rise.
	;
	; This guard is the price of letting the key skip the stall test. Waiting to
	; be stopped happened to exclude sloping ground for free -- you are not
	; stopped by a hill, you walk up it -- and without it, pressing the key while
	; facing any rise finds the highest sample somewhere up the slope and hauls
	; the player to it. Which is what climbing "on flat ground" actually was:
	; not flat, just gradual.
	;
	; Asking for a plateau at the top was the first attempt and it was the wrong
	; question -- a *gentle* slope has plenty of stops within tolerance of its
	; highest one, precisely because it is gentle. The discontinuity is what
	; matters, so the test is the size of the jump onto the winning surface:
	; ground gains a unit or two per stop, a ledge arrives all at once.
	if fVaultHeight < fLowMax
		if fRise < 10
			PrintC "Mantle: low, no step (rise %.0f depth %.0f)" fRise fDepth
			return
		endif
	endif

	; Kept before the clearance is added, because the animation is chosen against
	; the height of the obstacle, not against how far the body is lifted over it.
	set fPickH to fVaultHeight

	set fVaultHeight to fVaultHeight + 8

	; Where to come down, and why there has to be a "where" at all.
	;
	; Until now the climb only ever went up. Forward was left to the player's own
	; walking -- and the trigger has just finished insisting that the player is
	; barely moving, because that is what being stopped by an obstacle means. So
	; the two halves contradicted each other: we required a standstill and then
	; relied on a walk. On a low crate it did not show, since the feet finish
	; eight units above the top and an ordinary step covers the rest. The taller
	; the obstacle, the longer the climb spends rising against a flat face with
	; nothing carrying the body over it, and the surer the slide back down.
	;
	; Twenty units past the winning sample. The sample sits at the near edge --
	; it is the first stop that came back at the top height, later stops of the
	; same height never beat it -- so landing on it exactly is landing on the
	; lip. Twenty puts the body over the surface on anything deep, and clean past
	; it on a fence, which is the right answer for both.
	;
	; Clamped to the distance the head-height ray reached. That ray is the only
	; evidence we have that the space is free, and SetPos does not check
	; collision, so travelling past it would be moving on no evidence at all.
	set fGoDist to fBestDist + 20
	if fGoDist > fClear
		set fGoDist to fClear
	endif

	set fGoX to fDirX * fGoDist
	set fGoX to fStartX + fGoX
	set fGoY to fDirY * fGoDist
	set fGoY to fStartY + fGoY

	set fDuration to fVaultHeight / fPlayerHeight
	set fDuration to fDuration * 0.55
	set fDuration to fDuration + 0.10

	; Scaled by how far this climb actually goes, so a kerb reads as a step and a
	; wall reads as an effort. The measurement is already in hand.
	set fCamNudge to player.AuxVarGetFlt "*_Mantle_CamNudge" 0
	set fCamNudge to fCamNudge * fPickH
	set fCamNudge to fCamNudge / fMaxHeight

	set fCamDur to player.AuxVarGetFlt "*_Mantle_CamDur" 0
	if fCamDur > 0
		player.AuxVarSetFlt "*_Mantle_CamTotal" fCamDur 0
		player.AuxVarSetFlt "*_Mantle_CamTime" fCamDur 0
		player.AuxVarSetFlt "*_Mantle_CamNudgeNow" fCamNudge 0
		player.AuxVarSetFlt "*_Mantle_CamOff" 0 0

		; Seeded with the heading we start from, or the first frame of drag
		; measures against a stale one and snaps.
		set fCamYaw to player.GetAngle Z
		player.AuxVarSetFlt "*_Mantle_CamPrevYaw" fCamYaw 0
	endif

	; The heading for the parting shove, in the convention PushActorNoRagdoll
	; wants -- B42Interact builds it the same way, as 270 minus the arc tangent
	; of the travel vector.
	set fPushHead to fATan2 fDirY fDirX
	set fPushHead to 270 - fPushHead
	player.AuxVarSetFlt "*_Mantle_PushHead" fPushHead 0

	player.AuxVarSetFlt "*_Mantle_Air" fAir 0
	player.AuxVarSetFlt "*_Mantle_Height" fVaultHeight 0
	player.AuxVarSetFlt "*_Mantle_StartZ" fStartZ 0
	player.AuxVarSetFlt "*_Mantle_Start" fStartX 0
	player.AuxVarSetFlt "*_Mantle_Start" fStartY 1
	player.AuxVarSetFlt "*_Mantle_Go" fGoX 0
	player.AuxVarSetFlt "*_Mantle_Go" fGoY 1
	player.AuxVarSetFlt "*_Mantle_Duration" fDuration 0
	player.AuxVarSetFlt "*_Mantle_Time" fDuration 0
	player.AuxVarSetFlt "*_Mantle_Cooldown" 0.5 0

	PrintC "Mantle: GO height %.1f forward %.0f duration %.2f" fVaultHeight fGoDist fDuration

	; Standing Player Physics down for the lift is not one decision, it is four,
	; and they do not all point the same way.
	;
	; For:  its model accelerates out of a standstill over a couple of tenths of
	;       a second, and a standstill is exactly what being stopped by a fence
	;       is. Vanilla movement leaves the top of the obstacle much faster, and
	;       failing to leave it means dropping back down the near side.
	;
	; Against: the engine's own rooting is only suppressed while Player Physics
	;       owns the player. Handing him back re-arms it during the one moment a
	;       special idle is playing, which is precisely what rooting is for. And
	;       the faked fall distance goes with it, so the drop on the far side can
	;       be charged as a fall.
	;
	; Which wins is a question about how it feels, so it is a switch. Note the
	; idle only plays in first person -- if third person vaults noticeably better
	; with this on, rooting is the reason.
	; Stood down on the ground, left alone in the air.
	;
	; On the ground the case for standing it down still holds: its model spends a
	; couple of tenths of a second accelerating out of a standstill, and a
	; standstill is exactly what being stopped by an obstacle is.
	;
	; In the air it is the wrong thing to do, and for a reason that has nothing to
	; do with the movement model. Player Physics runs the player at roughly double
	; gravity; standing it down swaps that back to the engine's value for the
	; length of the climb and then swaps it back again. That is a discontinuity
	; dropped into the middle of a jump arc -- the arc the player aimed at the
	; next ledge -- and it is felt as the jump going soft.
	;
	; Everything else about handing him back is also worse up here: rooting is
	; re-armed exactly while the idle plays, and the faked fall distance goes
	; away, so the landing on the far side can be charged as a fall.
	set fYield to player.AuxVarGetFlt "*_Mantle_Yield" 0
	if fYield
		if fAir == 0
			PPBeginInteraction
		endif
	endif

	; One of ten, chosen here rather than left to a text key in the animation.
	;
	; A key can name one sound per animation, and naming it means naming a form,
	; which means an esp. `PlaySoundFromPath` takes the file directly, so the
	; whole thing stays esp-less and the choice becomes a number.
	;
	; The path is built rather than listed, so adding an eleventh file is one
	; number in the load script.
	set fSounds to player.AuxVarGetFlt "*_Mantle_Sounds" 0
	if fSounds > 0
		set iSnd to GetRandomPercent * fSounds
		set iSnd to iSnd / 100
		set iSnd to iSnd + 1

		if iSnd < 10
			sSnd = "Data\Sound\FX\STRADAT\climb_0" + $(iSnd) + ".wav"
		else
			sSnd = "Data\Sound\FX\STRADAT\climb_" + $(iSnd) + ".wav"
		endif

		PlaySoundFromPath (sSnd) 0 1
	endif

	if IsPC1stPerson
		; Which of the three to play.
		;
		; Sprinting first: it is a whole-body state and the animation for it is a
		; running vault, which is right whatever the obstacle turns out to be.
		; Enhanced Movement publishes the flag, and three other mods in this load
		; order read it the same way.
		;
		; Then height. A low obstacle is stepped over rather than hauled onto,
		; which is a different motion for the whole body.
		;
		; There is no weapon test any more -- the animations hide the weapon
		; themselves, so what is in hand no longer changes what the arms do.
		set fSprint to player.AuxVarGetFlt "*_EMSprint" 0

		set fLow to 0
		if fPickH < fLowMax
			set fLow to 1
		endif

		if fSprint
			set rIdle to player.AuxVarGetRef "*_Mantle_IdleS"
		elseif fLow
			set rIdle to player.AuxVarGetRef "*_Mantle_IdleL"
		else
			set rIdle to player.AuxVarGetRef "*_Mantle_IdleB"
		endif

		PrintC "Mantle: anim sprint %.0f low %.0f snd %.0f" fSprint fLow iSnd
		player.ForcePlayIdle rIdle
	endif

end
