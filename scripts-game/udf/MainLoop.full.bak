; Mantle -- the measuring and the movement.
;
; Runs at 90 Hz but does almost nothing until the player is actually stuck: the
; first real test is a plugin call that reads a field, and everything expensive
; sits behind it.
;
; Deliberately plain: no expression passed as an argument to anything, and no
; function outside the set this load order is already known to use. The first
; version failed to compile and JIP does not say where, so the whole class of
; suspects is gone rather than narrowed.
;
; Only the lift is driven. Forward travel is left to the player still holding
; the key, which is how Climbing gets over things and avoids needing the
; heading, and with it any trigonometry.

float fBlocked
float fVaultTime
float fVaultHeight
float fStartZ
float fStartX
float fStartY
float fPlayerHeight
float fMaxHeight
float fMinHeight
float fReach
float fTopZ
float fCastOK
float fHitX
float fHitY
float fHitZ
float fProbeX
float fProbeY
float fCastTopZ
float fCastBotZ
float fHeadBotZ
float fDuration
float fT
float fEase
float fNewZ
float fCooldown
float fLimit
ref rIdle

begin function {}

	set fVaultTime to player.AuxVarGetFlt "*_Mantle_Time" 0

	; ---- a vault already in progress ----------------------------------------
	if fVaultTime > 0
		set fVaultHeight to player.AuxVarGetFlt "*_Mantle_Height" 0
		set fStartZ to player.AuxVarGetFlt "*_Mantle_StartZ" 0
		set fDuration to player.AuxVarGetFlt "*_Mantle_Duration" 0

		set fVaultTime to fVaultTime - GetSecondsPassed
		player.AuxVarSetFlt "*_Mantle_Time" fVaultTime 0

		if fVaultTime <= 0
			return
		endif

		; sqrt front-loads the lift, so the knees clear the obstacle early and
		; the rest of the movement is the player walking on.
		set fT to fDuration - fVaultTime
		set fT to fT / fDuration
		; 1 - (1-t)^2. Front-loads the lift the way a square root would, using
		; nothing but multiplication -- fsqrt is not used by a single script in
		; the reference set, so it is not worth betting the compile on.
		set fEase to 1 - fT
		set fEase to fEase * fEase
		set fEase to 1 - fEase
		set fNewZ to fVaultHeight * fEase
		set fNewZ to fStartZ + fNewZ
		player.SetPos Z fNewZ
		return
	endif

	; ---- cooldown -----------------------------------------------------------
	set fCooldown to player.AuxVarGetFlt "*_Mantle_Cooldown" 0
	if fCooldown > 0
		set fCooldown to fCooldown - GetSecondsPassed
		player.AuxVarSetFlt "*_Mantle_Cooldown" fCooldown 0
		return
	endif

	; ---- intent -------------------------------------------------------------
	; Manual, as Climbing does it. Saying what you want removes every question
	; about telling a fence from an NPC, a doorway or a slope.
	if IsControlPressed 0 == 0
		return
	endif
	if IsControlPressed 12 == 0
		return
	endif

	; ---- blocked ------------------------------------------------------------
	set fBlocked to MantleBlockedTime
	if fBlocked < 0.15
		return
	endif

	if player.GetDead
		return
	endif
	if player.IsSneaking
		return
	endif
	if player.GetAnimAction == 2
		return
	endif
	if player.GetAV LeftMobilityCondition == 0
		return
	endif
	if player.GetAV RightMobilityCondition == 0
		return
	endif

	; ---- measure ------------------------------------------------------------
	set fPlayerHeight to player.GetObjectDimensions Z
	if fPlayerHeight < 1
		set fPlayerHeight to 128
	endif

	set fMaxHeight to fPlayerHeight * 0.5
	set fMinHeight to fPlayerHeight * 0.14

	player.GetPosEx (fStartX) (fStartY) (fStartZ)

	; The obstacle is straight ahead and the player is pressed against it, so a
	; cast straight down through their own position finds its top -- no heading
	; needed. The capsule keeps them about a foot clear of the face of it.
	set fProbeX to fStartX
	set fProbeY to fStartY

	set fCastTopZ to fStartZ + fMaxHeight
	set fCastTopZ to fCastTopZ + 16
	set fCastBotZ to fStartZ - 8

	; Straight down, so pitch is -90 and the heading does not matter. Collision
	; flag 19 and this call shape are lifted from B42 Leaning, which is the only
	; thing in this load order known to cast rays successfully.
	set fCastOK to GetPointRayCastPos fProbeX fProbeY fCastTopZ (-90) (0) (fHitX) (fHitY) (fHitZ) 19 200
	if fCastOK == 0
		return
	endif

	set fTopZ to fHitZ
	set fVaultHeight to fTopZ - fStartZ

	if fVaultHeight < fMinHeight
		return
	endif
	if fVaultHeight > fMaxHeight
		return
	endif

	; Headroom above the top, so nobody is launched into a low ceiling.
	set fHeadBotZ to fTopZ + 4
	set fHeadTopZ to fTopZ + fPlayerHeight
	set fLimit to fTopZ + fPlayerHeight
	set fCastOK to GetPointRayCastPos fProbeX fProbeY fHeadBotZ (90) (0) (fHitX) (fHitY) (fHitZ) 19 200
	if fCastOK != 0
		if fHitZ < fLimit
			return
		endif
	endif

	; ---- go -----------------------------------------------------------------
	; A little over the measured top, so the landing is on it and not in it.
	set fVaultHeight to fVaultHeight + 8

	; Duration scales with the height: a kerb is a flick, a chest-high ledge is
	; a heave. This is the whole point of measuring.
	set fDuration to fVaultHeight / fPlayerHeight
	set fDuration to fDuration * 0.55
	set fDuration to fDuration + 0.10

	player.AuxVarSetFlt "*_Mantle_Height" fVaultHeight 0
	player.AuxVarSetFlt "*_Mantle_StartZ" fStartZ 0
	player.AuxVarSetFlt "*_Mantle_Duration" fDuration 0
	player.AuxVarSetFlt "*_Mantle_Time" fDuration 0
	player.AuxVarSetFlt "*_Mantle_Cooldown" 0.5 0

	if IsPC1stPerson
		set rIdle to player.AuxVarGetRef "*_Mantle_Idle"
		player.ForcePlayIdle rIdle
	endif

end
